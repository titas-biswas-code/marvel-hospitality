        {
          "name": "Bank transactions",
          "item": [
            {
              "name": "Post bank transaction (new → 202)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bankTransactionRef\": \"{{bank_tx_ref}}\",\n  \"debtorAccountNumber\": \"NL91ABNA0417164300\",\n  \"debtorName\": \"A. Lovelace\",\n  \"amount\": 120.00,\n  \"currency\": \"EUR\",\n  \"remittanceInformation\": \"1401541457 P4145478\",\n  \"bookedAt\": \"2026-10-01T09:15:00Z\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{payment_url}}/bank-transactions",
                  "host": [
                    "{{payment_url}}"
                  ],
                  "path": [
                    "bank-transactions"
                  ]
                },
                "description": "Posts a new bank transaction (role bank:ingest, service account bank-simulator). Run 'Get token (bank-simulator, client credentials)' first. A pre-request script generates a fresh bankTransactionRef and stores it as bank_tx_ref; paymentId from the response is stored as bank_payment_id for the following requests."
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
