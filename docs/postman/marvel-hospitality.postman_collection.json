    {
      "name": "room-reservation-service",
      "item": [
        {
          "name": "whoami",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{reservation_url}}/whoami",
              "host": ["{{reservation_url}}"],
              "path": ["whoami"]
            },
            "description": "Bearer-authenticated identity check: subject, username, roles[], properties[]."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"roles is an array\", function () {",
                  "    pm.expect(json.roles).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"properties is an array\", function () {",
                  "    pm.expect(json.properties).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "whoami without token → 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{reservation_url}}/whoami",
              "host": ["{{reservation_url}}"],
              "path": ["whoami"]
            },
            "description": "No Authorization header: expects a 401 ProblemDetail with code UNAUTHENTICATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/problem+json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"code is UNAUTHENTICATED\", function () {",
                  "    pm.expect(json.code).to.eql(\"UNAUTHENTICATED\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
