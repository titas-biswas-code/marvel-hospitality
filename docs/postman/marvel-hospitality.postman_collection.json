                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customerName\": \"Ada Lovelace\",\n  \"roomNumber\": \"202\",\n  \"startDate\": \"2027-09-10\",\n  \"endDate\": \"2027-09-12\",\n  \"roomSegment\": \"MEDIUM\",\n  \"paymentMode\": \"CREDIT_CARD\",\n  \"paymentReference\": \"OK-123\"\n}",
