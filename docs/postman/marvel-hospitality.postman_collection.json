            {
              "name": "Create credit-card reservation (payment service unavailable → 503)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customerName\": \"Ada Lovelace\",\n  \"roomNumber\": \"202\",\n  \"startDate\": \"2027-10-10\",\n  \"endDate\": \"2027-10-12\",\n  \"roomSegment\": \"MEDIUM\",\n  \"paymentMode\": \"CREDIT_CARD\",\n  \"paymentReference\": \"SLOW-1\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{reservation_url}}/properties/AMS01/reservations",
                  "host": [
                    "{{reservation_url}}"
                  ],
                  "path": [
                    "properties",
                    "AMS01",
                    "reservations"
                  ]
                },
                "description": "Always 503 PAYMENT_SERVICE_UNAVAILABLE with Retry-After: 5, and never books anything. With the stub running, the SLOW prefix makes it answer after 5 s, past our 2 s read timeout: three attempts, about 6.5 s. With the stub stopped (`docker compose -f infra/docker-compose.yml stop credit-card-payment-service`), the connection fails and the answer comes in about 2-3 s. Repeat it a few times and the circuit breaker opens: the answer is then immediate, without any call. Start the stub again afterwards."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 503\", function () {",
                      "    pm.response.to.have.status(503);",
                      "});",
                      "",
                      "pm.test(\"code is PAYMENT_SERVICE_UNAVAILABLE with Retry-After\", function () {",
                      "    pm.expect(pm.response.json().code).to.eql(\"PAYMENT_SERVICE_UNAVAILABLE\");",
                      "    pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"5\");",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
