                },
                "url": {
                  "raw": "{{reservation_url}}/properties/AMS01/reservations",
                  "host": [
                    "{{reservation_url}}"
                  ],
                  "path": [
                    "properties",
                    "AMS01",
                    "reservations"
                  ]
                },
                "description": "Creates a CREDIT_CARD reservation for AMS01 room 202 (MEDIUM). The reservation service first asks credit-card-payment-service for the status of paymentReference OK-123 (stub: prefix OK → CONFIRMED), then stores it CONFIRMED. Saves reservationId. Re-running it gives 409 PAYMENT_REFERENCE_ALREADY_USED (one card payment backs one reservation), without calling the payment service; change paymentReference (e.g. OK-124) and the dates to book again."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 201\", function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "const json = pm.response.json();",
                      "",
                      "pm.test(\"status is CONFIRMED\", function () {",
                      "    pm.expect(json.status).to.eql(\"CONFIRMED\");",
                      "    pm.expect(json.paymentReference).to.eql(\"OK-123\");",
                      "});",
                      "",
                      "if (pm.response.code === 201) { pm.environment.set(\"reservationId\", json.reservationId); }"
                    ]
                  }
                }
              ],
              "response": []
