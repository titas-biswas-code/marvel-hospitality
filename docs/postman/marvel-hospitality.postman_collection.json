                      "pm.test(\"reservationStatuses is an array\", function () {",
                      "    pm.expect(json.reservationStatuses).to.be.an(\"array\").that.is.not.empty;",
                      "});",
                      "",
                      "pm.test(\"paymentModes is an array\", function () {",
                      "    pm.expect(json.paymentModes).to.be.an(\"array\").that.is.not.empty;",
                      "});"
                    ]
                  }
                }
              ],
