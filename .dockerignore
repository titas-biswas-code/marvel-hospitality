# Build context for every service is the repo root: they need ../platform and/or ../docs/contracts at build
# time — see infra/docker-compose.yml.
**/build
**/.gradle
**/bin
**/.idea
**/*.iml
**/.DS_Store
.git
infra/.env
# Only the contracts are build inputs (the credit-card OpenAPI spec, PR-03); ADRs, plans and Postman are not.
docs/*
!docs/contracts
**/node_modules
