# LOCAL DEVELOPMENT DEFAULTS ONLY — not secrets.
# `make up` copies this file to infra/.env if it does not exist. Real deployments inject these from a
# secret manager (Vault, AWS Secrets Manager, Kubernetes Secrets); nothing here may be reused outside a laptop.

# --- Postgres (superuser + one role per service database, ADR-0003) ---
POSTGRES_PASSWORD=postgres
RESERVATION_DB_PASSWORD=reservation
PAYMENT_DB_PASSWORD=payment
NOTIFICATION_DB_PASSWORD=notification

# --- Kafka (KRaft) ---
# Any base64 UUID; fixed so the single-node cluster keeps its identity across restarts.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --- Keycloak ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Confidential client secrets baked into infra/keycloak/realm/marvel-realm.json by bootstrap.sh + export.sh.
BANK_SIMULATOR_CLIENT_SECRET=bank-simulator-dev-secret
ROOM_RESERVATION_SERVICE_CLIENT_SECRET=room-reservation-service-dev-secret
BANK_TRANSFER_PAYMENT_SERVICE_CLIENT_SECRET=bank-transfer-payment-service-dev-secret
# Password for the dev users alice, bob, carol (contracts/security.md).
DEV_USER_PASSWORD=password

# --- room-reservation-service settings (not secrets) ---
# Auto-cancel of unpaid bank-transfer reservations (ADR-0010): on/off and the pause between runs (ISO-8601 duration).
# PT5S makes the README "Auto-cancel" demo quick; production-like default is PT60S.
RESERVATION_AUTO_CANCEL_ENABLED=true
RESERVATION_AUTO_CANCEL_INTERVAL=PT60S
