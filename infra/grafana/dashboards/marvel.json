  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Reservations",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reservations created by payment mode and status",
      "description": "Reservations created (reservation.created), by payment mode and the status they were created in. Totals since each service started: a counter's first event creates its series at 1, so rate()/increase() would miss it at demo volumes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (paymentMode, status) (reservation_created_total)",
          "legendFormat": "{{paymentMode}} \u2192 {{status}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reservations created, by status",
      "description": "Reservations created (reservation.created), by the status they were created in. Totals since each service started: a counter's first event creates its series at 1, so rate()/increase() would miss it at demo volumes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (reservation_created_total)",
          "legendFormat": "{{status}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Auto-cancelled and still overdue",
      "description": "Bank-transfer reservations cancelled at their payment deadline (ADR-0010), and how many are overdue but not yet cancelled after the last run. Totals since each service started: a counter's first event creates its series at 1, so rate()/increase() would miss it at demo volumes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(reservation_autocancel_cancelled_total)",
          "legendFormat": "cancelled",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(reservation_autocancel_overdue)",
          "legendFormat": "overdue, still pending",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
