{
  "id": null,
  "uid": "marvel-service-health",
  "title": "Marvel – Service health",
  "tags": [
    "marvel"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(jvm_info, service)",
        "query": {
          "query": "label_values(jvm_info, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP (inbound)",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Inbound HTTP request throughput per service, excluding actuator endpoints.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(http_server_requests_milliseconds_count{service=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio",
      "description": "Share of inbound requests answered with a 5xx status, per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(http_server_requests_milliseconds_count{service=~\"$service\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) / sum by (service) (rate(http_server_requests_milliseconds_count{service=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4xx responses per second by status",
      "description": "Inbound requests answered with a 4xx status, broken out per service and status code.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service, status) (rate(http_server_requests_milliseconds_count{service=~\"$service\", uri!~\"/actuator.*\", status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{status}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Inbound HTTP request latency percentiles per service, excluding actuator endpoints.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(http_server_requests_milliseconds_bucket{service=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p50 {{service}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_milliseconds_bucket{service=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{service}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_requests_milliseconds_bucket{service=~\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p99 {{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "HTTP (outbound) & resilience",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Credit-card call: average and max latency",
      "description": "Outbound HTTP client latency to the credit-card payment service, average and max, per service and URI.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service, uri) (rate(http_client_requests_milliseconds_sum{service=~\"$service\"}[$__rate_interval])) / sum by (service, uri) (rate(http_client_requests_milliseconds_count{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "avg {{uri}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (service, uri) (http_client_requests_max_milliseconds{service=~\"$service\"})",
          "legendFormat": "max {{uri}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Circuit breaker state",
      "description": "Current state of each named circuit breaker; only the active state (value 1) is shown.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "noValue": "no circuit breaker",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name, state) (resilience4j_circuitbreaker_state{service=~\"$service\"}) == 1",
          "legendFormat": "{{name}}: {{state}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Credit-card retries by kind",
      "description": "Resilience4j retry attempts against the credit-card payment service, per retry name and outcome kind.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name, kind) (increase(resilience4j_retry_calls_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{name}} {{kind}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Heap used vs max",
      "description": "JVM heap memory used against the configured maximum, per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "used {{service}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (jvm_memory_max_bytes{service=~\"$service\", area=\"heap\"} > 0)",
          "legendFormat": "max {{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GC pause time per second",
      "description": "Time spent in garbage-collection pauses per second, per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(jvm_gc_pause_milliseconds_sum{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Live threads",
      "description": "Number of live JVM threads per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (jvm_threads_live{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process CPU",
      "description": "Process CPU usage ratio per service, as reported by the JVM.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (service) (process_cpu_usage{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Connection pool",
      "description": "HikariCP connection pool occupancy per service: active, idle and pending connections.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\"})",
          "legendFormat": "active {{service}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (hikaricp_connections_idle{service=~\"$service\"})",
          "legendFormat": "idle {{service}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (hikaricp_connections_pending{service=~\"$service\"})",
          "legendFormat": "pending {{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Connection acquire time (avg)",
      "description": "Average time spent acquiring a connection from the HikariCP pool, per service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(hikaricp_connections_acquire_milliseconds_sum{service=~\"$service\"}[$__rate_interval])) / sum by (service) (rate(hikaricp_connections_acquire_milliseconds_count{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Logs & uptime",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Warnings and errors logged",
      "description": "Log events at WARN or ERROR level per service, counted over the selected rate interval.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 61 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service, level) (increase(logback_events_total{service=~\"$service\", level=~\"warn|error\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{level}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Uptime",
      "description": "Time each service instance has been running since its last restart.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 61 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (service) (process_uptime_milliseconds{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    }
  ]
}
